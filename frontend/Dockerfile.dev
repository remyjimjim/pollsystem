# syntax=docker/dockerfile:1
#
# Frontend DEV container — runs the Vite dev server with HMR for local
# docker-compose. Production frontend is built + served by Cloudflare Pages
# (see docs/DEPLOYING-CLOUDFLARE-PAGES.md), NOT this image.
FROM node:22-bookworm-slim
WORKDIR /app

# Install deps in their own layer, keyed on the lockfile. At runtime node_modules
# is a named compose volume, so the container keeps its own platform-native
# binaries (esbuild, @tailwindcss/oxide) instead of the host's bind-mounted copy.
COPY package.json package-lock.json ./
RUN npm ci && cp package-lock.json node_modules/.lockfile-stamp

# Copy the source so the image is runnable standalone; compose bind-mounts the
# working tree over /app at runtime for live edits.
COPY . .

EXPOSE 3000
# The node_modules volume is only filled from this image when it's first
# created, so packages added later would be missing ("Failed to resolve import").
# On each start, reinstall from the lockfile if it changed since the last
# install (stamp kept in the volume); otherwise start straight away. npm ci
# never rewrites the bind-mounted lockfile.
# --host binds 0.0.0.0 so the dev server is reachable from outside the container.
CMD ["sh", "-c", "if ! cmp -s package-lock.json node_modules/.lockfile-stamp; then echo 'package-lock.json changed: npm ci' && npm ci --no-audit --no-fund && cp package-lock.json node_modules/.lockfile-stamp; fi && exec npm run dev -- --host"]
